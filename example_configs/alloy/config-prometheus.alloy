prometheus.exporter.unix "local_system" { }

prometheus.exporter.unix "hoststats" {
    enable_collectors = ["cpu","meminfo"]
    sysfs_path  = "/host/sys"
    procfs_path = "/host/proc"
    rootfs_path = "/host/rootfs"
    include_exporter_metrics = true
}

prometheus.scrape "hostscraper" {
    targets = prometheus.exporter.unix.hoststats.targets
    forward_to = [prometheus.remote_write.prometheusout.receiver]
}

prometheus.remote_write "prometheusout" {
    endpoint {
        url=sys.env("PROMETHEUS_ENDPOINT_URL")
        write_relabel_config {
            target_label = "node"
	        replacement = sys.env("NODE_NAME")
	    }
    }
}